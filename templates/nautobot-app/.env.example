# Local environment for {{PROJECT_NAME}}. Copy to `.env` (gitignored) and fill
# in real values — never commit `.env` itself.
#
# GitHub Actions secrets (CLAUDE_CODE_OAUTH_TOKEN, GH_PAT) that drive
# .github/workflows/claude.yml are configured separately as repo secrets,
# not here — this file is only for values a local dev environment reads.

# A running Nautobot instance to develop/test this app against.
NAUTOBOT_URL=http://localhost:8080
NAUTOBOT_TOKEN=

# Runtime verbosity (e.g. debug, info, warn).
LOG_LEVEL=info
